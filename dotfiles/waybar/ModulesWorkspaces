{
  "hyprland/workspaces#roman": {
    "active-only": false,
    "all-outputs": false,
    "format": "{icon}",
    "show-special": false,
    "on-click": "activate",
    "on-scroll-up": "hyprctl dispatch workspace e+1",
    "on-scroll-down": "hyprctl dispatch workspace e-1",
    "persistent-workspaces": { "*": 5 },
    "format-icons": { "1": "I", "2": "II", "3": "III", "4": "IV", "5": "V" }
  }
}

